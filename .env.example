# Protects paid-provider requests to POST /api/lab
LAB_ACCESS_TOKEN=

# Chopstory Lab: OpenRouter transport (OpenAI, Qwen, GLM, DeepSeek)
OPENROUTER_API_KEY=
OPENROUTER_OPENAI_MODEL=openai/gpt-5.4-mini
OPENROUTER_QWEN_MODEL=qwen/qwen3.6-flash
OPENROUTER_GLM_MODEL=z-ai/glm-5v-turbo
OPENROUTER_DEEPSEEK_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_MINIMAX_MODEL=minimax/minimax-m3
OPENROUTER_STEPFUN_MODEL=stepfun/step-3.7-flash

# Alibaba Qwen: regional direct routes (keys are region-specific)
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen3.6-flash
DASHSCOPE_INTL_API_KEY=
DASHSCOPE_INTL_MODEL=qwen3.6-flash
DASHSCOPE_US_API_KEY=
DASHSCOPE_US_MODEL=qwen3.6-flash

# Google Gemini: direct
GOOGLE_API_KEY=
GOOGLE_API_BASE_URL=

# MiniMax: direct
MINIMAX_API_KEY=
# Leave blank for the domestic default; set https://api.minimax.io/v1 for an international key.
MINIMAX_BASE_URL=
MINIMAX_MODEL=MiniMax-M3

# StepFun: direct
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/v1
STEPFUN_MODEL=step-1o-turbo-vision

# Volcengine Doubao: direct; DOUBAO_MODEL is the inference endpoint ID
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=

# Product/mock controls
MOCK_LLM=
MOCK_DELAY_MS=80
MENULENS_MODEL=qwen-vl-max
